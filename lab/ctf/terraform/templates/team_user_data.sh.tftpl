#!/bin/bash
# 팀 서버 부팅 스크립트 (${team}). Amazon Linux 2023, 인터넷 없음.
# 패키지와 사이트 파일은 S3 게이트웨이 엔드포인트로 받는다.
# 이 스크립트는 메타데이터(IMDSv1)로 읽힌다 → 플래그를 넣지 않는다. 플래그는 inject_flags.sh(SSM)가 넣는다.
set -euxo pipefail
exec > /var/log/ctf-bootstrap.log 2>&1

TEAM='${team}'
REGION='${region}'
WEBROOT=/var/www/shop

# 1) 패키지 (AL2023 저장소는 리전 S3에 있어 게이트웨이 엔드포인트로 받아진다)
# AL2023은 버전 없는 패키지 이름을 쓴다(php8.3-* 는 없다). php-pdo 가 pdo_sqlite 를 포함한다.
dnf -y install nginx php-fpm php-pdo php-cli php-mbstring rsyslog gcc unzip openssl
systemctl enable --now rsyslog

# auth 기록을 Ubuntu와 같은 /var/log/auth.log 로도 남긴다(LogSight 파서 호환). sudo·su가 여기에 남는다.
echo 'authpriv.*  /var/log/auth.log' > /etc/rsyslog.d/10-authlog.conf
systemctl restart rsyslog

# 2) 스왑 1GB (3-2: 메모리 2GB에 php-fpm 16개 + nginx)
fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
echo '/swapfile swap swap defaults 0 0' >> /etc/fstab

# 3) 사이트 받기
mkdir -p "$WEBROOT" /var/lib/ctf /etc/ctf
aws s3 cp "s3://${ops_bucket}/site/site.zip" /tmp/site.zip --region "$REGION"
unzip -o /tmp/site.zip -d "$WEBROOT" && rm -f /tmp/site.zip
mkdir -p "$WEBROOT/uploads"
chown -R root:root "$WEBROOT" && chmod -R a+rX "$WEBROOT"
chown nginx:nginx "$WEBROOT/uploads" && chmod 0755 "$WEBROOT/uploads"
chown root:nginx /var/lib/ctf && chmod 0750 /var/lib/ctf
# 앱 DB(SQLite)는 nginx가 /var/lib/ctf/app 아래에 만든다. 플래그 파일(f1·f2)은 /var/lib/ctf에 root:nginx 0640.
install -d -o nginx -g nginx -m 0750 /var/lib/ctf/app
# PHP 세션 저장 경로: 기본값(/var/lib/php/session)은 nginx가 못 쓴다 → 관리자 로그인(F2) 세션이 안 남아 F3 업로드가 막힌다.
install -d -o nginx -g nginx -m 0700 /var/lib/ctf/app/sessions
echo ok > "$WEBROOT/health.txt"

# F6 단서: 셸(F3 이후)에서 보이는 앱 설정. 버킷 이름과 리전(시드니)을 적어 둔다.
cat > /etc/ctf/app.ini <<INI
[storage]
; 상품 이미지 백업 위치 (팀 전용 폴더)
bucket = ${flag_bucket}
prefix = ${team}/
region = ${region}
INI
chmod 0644 /etc/ctf/app.ini

# 4) php-fpm: nginx 사용자로, .phtml 실행 허용(설정 실수 재현, F3), 작업자 16개, 요청 30초
POOL=/etc/php-fpm.d/www.conf
sed -i 's/^user = .*/user = nginx/; s/^group = .*/group = nginx/' $POOL
sed -i 's/^pm = .*/pm = static/; s/^pm.max_children = .*/pm.max_children = 16/' $POOL
# listen/세션 경로를 명시한다(AL2023 기본 소켓 경로·소유자가 버전마다 달라 nginx 연결이 끊길 수 있다).
cat >> $POOL <<'POOLCONF'
listen = /run/php-fpm/www.sock
listen.owner = nginx
listen.group = nginx
listen.mode = 0660
security.limit_extensions = .php .phtml
request_terminate_timeout = 30s
php_admin_value[memory_limit] = 64M
php_admin_value[upload_max_filesize] = 2M
php_admin_value[post_max_size] = 3M
php_admin_value[session.save_path] = /var/lib/ctf/app/sessions
POOLCONF
mkdir -p /etc/systemd/system/php-fpm.service.d
printf '[Service]\nTasksMax=200\nCPUQuota=100%%\n' > /etc/systemd/system/php-fpm.service.d/limits.conf
systemctl daemon-reload
systemctl enable --now php-fpm

# 5) nginx: 팀 포트 기본 인증, 접속 로그에 X-Forwarded-For, 민감 파일 차단(3-3)
printf '%s:%s\n' "$TEAM" "$(openssl passwd -apr1 '${basic_pass}')" > /etc/nginx/ctf.htpasswd
chown root:nginx /etc/nginx/ctf.htpasswd && chmod 0640 /etc/nginx/ctf.htpasswd
cat > /etc/nginx/nginx.conf <<'NGINX'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    client_max_body_size 3m;
    log_format ctf '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
                   '"$http_referer" "$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log ctf;
    server {
        listen 80 default_server;
        root /var/www/shop;
        index index.php;
        location = /health.txt { auth_basic off; access_log off; }
        auth_basic "team";
        auth_basic_user_file /etc/nginx/ctf.htpasswd;
        location ~* \.(sqlite|sql|bak|old|orig|swp|ini|env|git)$ { return 403; }
        location ~ /\. { return 403; }
        location / { try_files $uri $uri/ /index.php?$query_string; }
        location ~ \.(php|phtml)$ {
            try_files $uri =404;
            fastcgi_pass unix:/run/php-fpm/www.sock;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_read_timeout 35s;
        }
    }
}
NGINX
nginx -t
systemctl enable --now nginx

# 6) F4: sudo 규칙 1개 (설계한 권한 상승 경로 하나만)
echo '${sudo_rule}' > /etc/sudoers.d/90-ctf
chmod 0440 /etc/sudoers.d/90-ctf
visudo -cf /etc/sudoers.d/90-ctf

# 7) 로그 전송: 1분마다 새로 쌓인 부분만 logs 버킷 hosts/<팀>/ 으로 (versioning으로 원본 보존)
aws s3 cp "s3://${ops_bucket}/site/ship-logs.sh" /usr/local/sbin/ctf-ship-logs --region "$REGION"
chmod 0700 /usr/local/sbin/ctf-ship-logs && chown root:root /usr/local/sbin/ctf-ship-logs
cat > /etc/ctf/ship.env <<ENV
TEAM=${team}
REGION=${region}
LOGS_BUCKET=${logs_bucket}
ENV
chmod 0600 /etc/ctf/ship.env
cat > /etc/systemd/system/ctf-ship-logs.service <<'UNIT'
[Unit]
Description=Ship CTF host logs to S3
[Service]
Type=oneshot
EnvironmentFile=/etc/ctf/ship.env
ExecStart=/usr/local/sbin/ctf-ship-logs
UNIT
cat > /etc/systemd/system/ctf-ship-logs.timer <<'UNIT'
[Unit]
Description=Ship CTF host logs every minute
[Timer]
OnBootSec=60
OnUnitActiveSec=60
AccuracySec=5
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now ctf-ship-logs.timer

# 8) 시간: Amazon Time Sync(169.254.169.123)는 AL2023 chrony 기본값. 정답지 시각과 로그를 맞춘다.
chronyc tracking || true

echo "ctf ${team} ready" > /var/log/ctf-ready
